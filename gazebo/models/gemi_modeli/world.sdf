<?xml version="1.0"?>
<sdf version="1.9">
  <world name="gemi_dunyasi">

    <!-- Fizik motoru -->
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>2.0</real_time_factor>
    </physics>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>41.015137</latitude_deg>
      <longitude_deg>28.979530</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <wind>
      <linear_velocity>5 0 0</linear_velocity>
    </wind>
    

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"></plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"></plugin>

    <!-- Buoyancy (yüzerlik) plugin'i -->
    <plugin
      filename="gz-sim-buoyancy-system"
      name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1025</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1.2</density>
        </density_change>
      </graded_buoyancy>
      <enable>gemi_modeli::govde</enable>
      <enable>gemi_modeli::dumen</enable>
      <enable>gemi_modeli::pervane</enable>
    </plugin>
<!--
    <plugin filename="gz-sim-wind-effects-system" name="gz::sim::systems::WindEffects">
      <force_approximation_scaling_factor>0.05</force_approximation_scaling_factor>
      <horizontal>
        <magnitude>
          <time_for_rise>5</time_for_rise>
          <sin>
            <amplitude_percent>0.3</amplitude_percent>
            <period>30</period>
          </sin>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>0.5</stddev>
          </noise>
        </magnitude>
        <direction>
          <time_for_rise>8</time_for_rise>
          <sin>
            <amplitude>3.14159</amplitude>
            <period>180</period>
          </sin>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>0.15</stddev>
          </noise>
        </direction>
      </horizontal>
      <vertical>
        <time_for_rise>5</time_for_rise>
        <noise type="gaussian">
          <mean>0</mean>
          <stddev>0.1</stddev>
        </noise>
      </vertical>
    </plugin>
-->
    <!-- Güneş ışığı -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Görsel su yüzeyi -->
    <model name="su_yuzeyi">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <plane>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.0 0.3 0.6 0.6</ambient>
            <diffuse>0.0 0.4 0.7 0.6</diffuse>
            <transparency>0.4</transparency>
          </material>
        </visual>
      </link>
    </model>

    <!-- Şamandıra -->
    <model name="samandira_1">
      <static>true</static>
      <pose>40 15 0 0 0 0</pose>
      <link name="govde">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.6</radius><length>1.2</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.6</radius><length>1.2</length></cylinder>
          </geometry>
          <material>
            <ambient>1 0.3 0 1</ambient>
            <diffuse>1 0.3 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Demirli tekne engeli -->
    <model name="engel_tekne_1">
      <static>true</static>
      <pose>70 -10 0 0 0 0.3</pose>
      <link name="govde">
        <collision name="collision">
          <geometry>
            <box><size>8 2.5 2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>8 2.5 2</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Mendirek parçası -->
    <model name="mendirek_1">
      <static>true</static>
      <pose>120 0 0 0 0 0</pose>
      <link name="govde">
        <collision name="collision">
          <geometry>
            <box><size>30 4 3</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>30 4 3</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Gemi modelini dünyaya ekle -->
    <include>
      <uri>model://gemi_modeli</uri>
      <name>gemi_modeli</name>
      <pose>0 0 -0.1091 0 0 0</pose>
    </include>

  </world>
</sdf>